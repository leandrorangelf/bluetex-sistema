NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# VHSYS: mesma API para todas as unidades, mas cada unidade tem sua própria
# conta/API key. Preencha um bloco por unidade (o código é o sufixo da
# variável — precisa bater com lib/vhsys/unidades.ts).
VHSYS_API_BASE_URL=

# NEW BLUETEX MG
VHSYS_ACCESS_TOKEN_MG=
VHSYS_SECRET_ACCESS_TOKEN_MG=
VHSYS_PARTNER_TOKEN_MG=

# NEW BLUETEX SC
VHSYS_ACCESS_TOKEN_SC=
VHSYS_SECRET_ACCESS_TOKEN_SC=
VHSYS_PARTNER_TOKEN_SC=

# NEW BLUETEX AM
VHSYS_ACCESS_TOKEN_AM=
VHSYS_SECRET_ACCESS_TOKEN_AM=
VHSYS_PARTNER_TOKEN_AM=

# GB SP
VHSYS_ACCESS_TOKEN_GB_SP=
VHSYS_SECRET_ACCESS_TOKEN_GB_SP=
VHSYS_PARTNER_TOKEN_GB_SP=

# GB CE
VHSYS_ACCESS_TOKEN_GB_CE=
VHSYS_SECRET_ACCESS_TOKEN_GB_CE=
VHSYS_PARTNER_TOKEN_GB_CE=

# GB MA
VHSYS_ACCESS_TOKEN_GB_MA=
VHSYS_SECRET_ACCESS_TOKEN_GB_MA=
VHSYS_PARTNER_TOKEN_GB_MA=

# Sincronização automática do VHSYS (Vercel Cron). Opcional — sem isso, só a
# sincronização manual funciona.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
